{
  "name": "bandana-devstand",
  "private": true,
  "scripts": {
    "postgres": "docker compose up -d",
    "server": "npm run dev --prefix bandana-server",
    "client": "npm start --prefix bandana-client",
    "dev": "npm run postgres && concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
