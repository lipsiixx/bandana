# Скопируй в .env и заполни своими значениями: cp .env.example .env

NODE_ENV=development
PORT=5000

# Публичный URL сервера — используется для формирования ссылок на загруженные файлы (uploads)
PUBLIC_URL=http://localhost:5000

# PostgreSQL (см. docker-compose.yml в корне ~/bandana для локального запуска)
# Порт 55432 — совпадает с docker-compose.yml (5432/5433 часто заняты локальным Postgres)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=bandana
DB_USER=bandana
DB_PASSWORD=bandana

# Telegram
BOT_TOKEN=your_bot_token_from_botfather
# Список Telegram ID администраторов через запятую
ADMINS_ID=123456789,987654321

# Секрет для подписи cookie (сгенерировать: openssl rand -hex 32)
COOKIE_SECRET=change_me_to_a_random_secret

# CORS: список разрешённых origin через запятую
CORS_ORIGINS=http://localhost:3000,https://bandana-dance.ru
