# Скопируй в .env и заполни своими значениями: cp .env.example .env

NODE_ENV=development
PORT=5000

# Публичный URL сервера — используется для формирования ссылок на загруженные файлы (uploads)
PUBLIC_URL=http://localhost:5000

# PostgreSQL (см. docker-compose.yml в корне ~/bandana для локального запуска)
# Порт 55432 — совпадает с docker-compose.yml (5432/5433 часто заняты локальным Postgres)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=bandana
DB_USER=bandana
DB_PASSWORD=bandana

# Telegram
BOT_TOKEN=your_bot_token_from_botfather
# Список Telegram ID администраторов через запятую
ADMINS_ID=123456789,987654321
# Прокси для обхода блокировки Telegram API (RKN и т.п.), если api.telegram.org
# недоступен напрямую с сервера. socks5://user:pass@host:port или http://user:pass@host:port.
# Пусто — прямое соединение.
TELEGRAM_PROXY=

# Секрет для подписи cookie (сгенерировать: openssl rand -hex 32)
# ОБЯЗАТЕЛЬНО — без него сервер не запустится (services/cookieService.js падает на старте)
COOKIE_SECRET=change_me_to_a_random_secret

# Секрет для внутренних эндпоинтов (/api/notify-user, /api/admin/block-user, /api/admin/unblock-user),
# которые не должны быть доступны публично — только боту/серверу самому себе.
# Без него эти эндпоинты отвечают 503. Сгенерировать: openssl rand -hex 32
INTERNAL_API_SECRET=

# Секрет для подписи сессионной cookie веб-админки (сгенерировать: openssl rand -hex 32)
# ОБЯЗАТЕЛЬНО — без него сервер не запустится (services/adminAuthService.js падает на старте)
ADMIN_SESSION_SECRET=change_me_to_a_random_secret

# Веб-админка (admin-panel) — именные аккаунты с ролями (owner/editor/moderator),
# не общий пароль. Эти три переменные используются ОДИН РАЗ — миграция
# 0003-admin-accounts.js создаёт из них первого owner'а, если таблица admin_users
# ещё пуста. После этого входят по email/паролю, которые дальше живут только в БД
# (новых людей добавляют приглашением из раздела "Доступы", а не через .env).
ADMIN_OWNER_EMAIL=owner@example.ru
ADMIN_OWNER_PASSWORD=change_me_to_a_strong_password
ADMIN_OWNER_NAME=Владелец

# Базовый URL admin-panel — используется только для формирования ссылок-приглашений
# (/accept-invite/<token>) в ответе POST /api/admin/invites. Приглашение не
# отправляется по email (SMTP не настроен) — ссылку владелец копирует и шлёт сам.
ADMIN_PANEL_URL=http://127.0.0.1:5173

# CORS: список разрешённых origin через запятую.
# admin-panel в dev слушает http://127.0.0.1:5173 (vite.config.js — host явно 127.0.0.1,
# не localhost, чтобы не словить IPv6-only bind на Windows)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,https://bandana-dance.ru

# Message Monitor (bot/utils/messageMonitor.js) — архивирует и пересылает владельцу
# ВСЕ сообщения из чатов, где состоит бот с MONITOR_BOT_TOKEN. Отключён по умолчанию.
# Включай только если участники соответствующих чатов знают о таком мониторинге.
MONITOR_ENABLED=false
# MONITOR_BOT_TOKEN=
# MONITOR_OWNER_ID=
